# Local: copy to .env.development (dev) or .env.production / use APP_ENV=preview with a
# matching .env.* file. Never commit real keys — see .gitignore and docs/DEPLOYMENT.md.
# Day-to-day: APP_ENV defaults to development (com.timesense.dev / timesense-dev).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Either works — Expo wizard uses KEY; older docs use ANON_KEY (JWT starting with eyJ...)
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-or-anon-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (from the RevenueCat dashboard, per-platform, per-project).
# Public/anon-style keys — safe to ship in the client bundle like the Supabase key above.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your-android-public-sdk-key

# Sentry crash reporting DSN (public, safe to ship in the client bundle).
# Only initializes when APP_ENV is preview/production — never fires in local dev,
# even if this is set in .env.development.
EXPO_PUBLIC_SENTRY_DSN=

# AdMob interstitial ad unit IDs (per-platform, from your own AdMob account) — shown once per
# Finish tap to non-Plus users only, see lib/ads.ts. Leave unset to fall back to Google's
# public test ad unit ID (always serves test creatives, safe for dev). Also requires
# ADMOB_ANDROID_APP_ID / ADMOB_IOS_APP_ID (build-time, not EXPO_PUBLIC_ — set as plain env vars
# or EAS secrets, read by app.config.js) for the app-level AdMob App ID.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS_ID=
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
